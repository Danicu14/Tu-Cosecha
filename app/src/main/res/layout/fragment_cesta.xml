<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Loading State -->
        <ProgressBar
            android:id="@+id/progressCestaLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/tvCestaEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="El hortelano está preparando la cesta de esta semana"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!-- Error State -->
        <LinearLayout
            android:id="@+id/layoutCestaError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Error al cargar la cesta"
                android:textSize="16sp"
                android:textColor="?attr/colorError"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCestaRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reintentar"
                app:cornerRadius="12dp" />

        </LinearLayout>

        <!-- Active Plan View (User with active subscription) -->
        <LinearLayout
            android:id="@+id/layoutCestaActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Green Gradient Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_account_header_gradient"
                    android:padding="24dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipActivePlan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Plan Familiar"
                        app:chipBackgroundColor="@color/verde_claro"
                        android:textColor="@color/verde_oscuro"
                        app:chipStrokeWidth="0dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tu cesta de esta semana"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvCestaRecogidaInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#E0E0E0"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvCestaDiasFaltan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/amarillo"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Qué recibirás"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvPremiumPriorityNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⭐ Tienes prioridad en productos escasos"
                android:textSize="13sp"
                android:textColor="?attr/colorSecondary"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProductosCesta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerMiPlanCesta"
                style="@style/Widget.TuCosecha.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Ver mi plan"
                android:layout_marginTop="24dp" />

        </LinearLayout>

        <!-- No Plan / Guest View -->
        <LinearLayout
            android:id="@+id/layoutCestaNoPlan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Esto hay en el huerto esta semana"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProductosCestaGuest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cómo funciona Tú Cosecha"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. Elige tu plan de suscripción adaptado a ti."
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. Descubre qué hay en el huerto de Talavera de la Reina."
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. Recibe tu cesta de productos frescos cada semana."
                android:textSize="15sp"
                android:textColor="?attr/colorOnSurface"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerPlanesCesta"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Ver planes"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrearCuentaCesta"
                style="@style/Widget.TuCosecha.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Crear cuenta"
                android:visibility="gone" />

        </LinearLayout>

    </FrameLayout>
</ScrollView>
