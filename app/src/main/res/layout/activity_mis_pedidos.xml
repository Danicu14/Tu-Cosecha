<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarMisPedidos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Mis Pedidos"
        app:titleTextColor="?attr/colorPrimary" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMisPedidos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp" />

        <LinearLayout
            android:id="@+id/layoutMisPedidosEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aún no has hecho ningún pedido"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCrearMiCesta"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="Crear mi cesta"
                android:layout_marginTop="24dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutMisPedidosError"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Error al cargar los pedidos"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/rojo_tomate"
                android:gravity="center" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReintentarPedidos"
                style="@style/Widget.TuCosecha.Button.Tonal"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:text="Reintentar"
                android:layout_marginTop="24dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
