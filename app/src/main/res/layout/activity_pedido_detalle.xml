<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarPedidoDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Detalle del Pedido"
        app:titleTextColor="?attr/colorPrimary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Gradient Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#E8F5E9"
                app:strokeWidth="1dp"
                app:strokeColor="#C8E6C9"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvDetalleEstadoHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tu cesta está confirmada"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="#1F5A2A" />

                    <TextView
                        android:id="@+id/tvDetalleInfoEntrega"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Detalles..."
                        android:textSize="14sp"
                        android:textColor="#2E7D32"
                        android:layout_marginTop="8dp" />

                    <TextView
                        android:id="@+id/tvDetalleCountdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Faltan N días"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#3E8E2F"
                        android:layout_marginTop="12dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Horizontal Progress Bar of 4 steps -->
            <LinearLayout
                android:id="@+id/layoutProgressSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="?attr/colorSurfaceVariant"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Estado del pedido"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:weightSum="4">

                    <!-- Step 1: Confirmado -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <View
                            android:id="@+id/indicatorStep1"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_circle_avatar" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Confirmado"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="4dp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- Step 2: Preparando -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <View
                            android:id="@+id/indicatorStep2"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_circle_avatar" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Preparando"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="4dp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- Step 3: En camino / Listo -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <View
                            android:id="@+id/indicatorStep3"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_circle_avatar" />
                        <TextView
                            android:id="@+id/tvStep3Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="En camino"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="4dp"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- Step 4: Entregado -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <View
                            android:id="@+id/indicatorStep4"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="@drawable/bg_circle_avatar" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Entregado"
                            android:textSize="11sp"
                            android:textColor="?attr/colorOnSurface"
                            android:layout_marginTop="4dp"
                            android:gravity="center" />
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <!-- Warning Banners for Cancellation -->
            <TextView
                android:id="@+id/tvCancellationPendingWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Has solicitado cancelar este pedido. El huerto te responderá pronto."
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:background="#FFE0B2"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCancellationRejectedWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="El huerto no ha podido cancelar tu pedido."
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#B71C1C"
                android:background="#FFCDD2"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Productos de tu pedido"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPedidoDetalleProductos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginBottom="24dp" />

            <!-- Action Button: Solicitar cancelación -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSolicitarCancelacion"
                style="@style/Widget.TuCosecha.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Solicitar cancelación"
                android:textColor="@color/rojo_tomate"
                app:strokeColor="@color/rojo_tomate" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
