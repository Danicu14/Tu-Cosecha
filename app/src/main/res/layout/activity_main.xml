<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Custom Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/layoutCustomBottomNav"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_custom_bottom_bar"
        android:elevation="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <!-- Item 1: Mi Cesta -->
        <LinearLayout
            android:id="@+id/navCesta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imgCesta"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/nav_mi_cesta"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/tvCesta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mi Cesta"
                android:textSize="11sp"
                android:maxLines="1"
                android:gravity="center"
                android:layout_marginTop="2dp" />

            <View
                android:id="@+id/lineCesta"
                android:layout_width="22dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_indicator_line"
                android:layout_marginTop="3dp"
                android:visibility="invisible" />

        </LinearLayout>

        <!-- Item 2: Productos -->
        <LinearLayout
            android:id="@+id/navProductos"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imgProductos"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/nav_productos"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/tvProductos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Productos"
                android:textSize="11sp"
                android:maxLines="1"
                android:gravity="center"
                android:layout_marginTop="2dp" />

            <View
                android:id="@+id/lineProductos"
                android:layout_width="22dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_indicator_line"
                android:layout_marginTop="3dp"
                android:visibility="invisible" />

        </LinearLayout>

        <!-- Item 3: Noticias -->
        <LinearLayout
            android:id="@+id/navNoticias"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imgNoticias"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/nav_noticias"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/tvNoticias"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Noticias"
                android:textSize="11sp"
                android:maxLines="1"
                android:gravity="center"
                android:layout_marginTop="2dp" />

            <View
                android:id="@+id/lineNoticias"
                android:layout_width="22dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_indicator_line"
                android:layout_marginTop="3dp"
                android:visibility="invisible" />

        </LinearLayout>

        <!-- Item 4: Mi Zona -->
        <LinearLayout
            android:id="@+id/navZona"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:id="@+id/imgZona"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/nav_mi_zona"
                android:scaleType="fitCenter"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/tvZona"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mi Zona"
                android:textSize="11sp"
                android:maxLines="1"
                android:gravity="center"
                android:layout_marginTop="2dp" />

            <View
                android:id="@+id/lineZona"
                android:layout_width="22dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_indicator_line"
                android:layout_marginTop="3dp"
                android:visibility="invisible" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
