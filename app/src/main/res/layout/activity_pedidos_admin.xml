<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarPedidosAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@android:drawable/ic_menu_revert"
        app:title="Gestión de Pedidos"
        app:titleTextColor="?attr/colorPrimary" />

    <ProgressBar
        android:id="@+id/progressAdminLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginVertical="32dp"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPedidosAdmin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card Total a preparar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTotalPreparar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#E8F5E9"
                app:strokeWidth="1dp"
                app:strokeColor="#C8E6C9"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total a preparar"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#1F5A2A" />

                    <TextView
                        android:id="@+id/tvSemanaCosechaAdmin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Cosecha activa"
                        android:textSize="13sp"
                        android:textColor="#2E7D32"
                        android:layout_marginTop="2dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvTotalPrepararResumen"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sin pedidos confirmados todavía"
                        android:textSize="14sp"
                        android:textColor="#1B5E20"
                        android:lineSpacingExtra="4dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Filter Chips Horizontal Scroll -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupFiltros"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFiltroPorPreparar"
                        style="@style/Widget.TuCosecha.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Por preparar" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFiltroCancelaciones"
                        style="@style/Widget.TuCosecha.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cancelaciones" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFiltroEnReparto"
                        style="@style/Widget.TuCosecha.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="En reparto" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFiltroEntregados"
                        style="@style/Widget.TuCosecha.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Entregados" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFiltroCancelados"
                        style="@style/Widget.TuCosecha.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cancelados" />

                </com.google.android.material.chip.ChipGroup>

            </HorizontalScrollView>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmptyAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvEmptyAdminMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No hay pedidos en esta sección"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:gravity="center" />

            </LinearLayout>

            <!-- Error State -->
            <LinearLayout
                android:id="@+id/layoutErrorAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Error al cargar pedidos"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/rojo_tomate"
                    android:gravity="center" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReintentarAdmin"
                    style="@style/Widget.TuCosecha.Button.Tonal"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="Reintentar"
                    android:layout_marginTop="16dp" />

            </LinearLayout>

            <!-- Orders RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPedidosAdmin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
